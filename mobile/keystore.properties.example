# Release signing credentials. Copy to `keystore.properties` (git-ignored) and fill in.
#
# Generate the keystore first:
#   keytool -genkeypair -v -keystore tutelage-release.jks -keyalg RSA \
#     -keysize 4096 -validity 10000 -alias tutelage
#
# BACK THE .jks FILE UP somewhere permanent and off this machine. If it is lost,
# no future build can ever update an already-installed app — every counsellor
# would have to uninstall and reinstall again.
#
# storeFile is resolved relative to the `mobile/` root (rootProject).
# In CI, use the ANDROID_KEYSTORE_FILE / ANDROID_KEYSTORE_PASSWORD /
# ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD environment variables instead.

storeFile=tutelage-release.jks
storePassword=
keyAlias=tutelage
keyPassword=
