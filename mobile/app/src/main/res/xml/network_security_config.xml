<?xml version="1.0" encoding="utf-8"?>
<!--
  Transport policy for the counsellor app.

  The app carries JWT bearer tokens, student PII and call recordings, so the
  default is HTTPS-only: `usesCleartextTraffic="true"` used to allow plaintext
  to ANY host, which made an insecure production config silent and trivial.

  Release builds also trust ONLY the system CA store. User-installed roots are
  common on managed / sideloaded enterprise devices and are exactly how an
  on-device proxy would read every request; they stay trusted in debug builds
  so Charles / mitmproxy still work during development.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Local development targets only. These are loopback / emulator-alias
      addresses that never leave the device or the developer's own machine, so
      permitting cleartext here does not expose anything on a real network.
      A production host must be https:// — assembleRelease fails otherwise
      (see the API_BASE_URL check in app/build.gradle.kts).
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>
