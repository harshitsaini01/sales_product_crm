# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tutelage_crm"
# For a local PostgreSQL database this is normally the same as DATABASE_URL.
# Hosted databases may use a pooled DATABASE_URL and a direct DIRECT_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/tutelage_crm"
#
# PRODUCTION SIZING — append to DATABASE_URL as query params:
#   ?connection_limit=N&pool_timeout=20
#
# connection_limit is PER PROCESS. Under PM2 cluster mode the real number of
# server connections is `connection_limit × worker count`, which must stay under
# Postgres' max_connections (and under the pooler's client limit if one is in
# front). The current production value of 5 is sized for a handful of users;
# raise it deliberately, with the worker count in the arithmetic, before putting
# a second company on this instance.
#
# pool_timeout (seconds) is how long a query waits for a free connection before
# throwing P2024. It is unset in production today, so it uses the 10s default —
# set it explicitly so the failure mode is a chosen number rather than a default.
 
# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# Email (Nodemailer SMTP)
SMTP_HOST="mail.britannicaoverseas.com"
SMTP_PORT=587
SMTP_USER="info@britannicaoverseas.com"
SMTP_PASS="your-email-password"
SMTP_FROM="info@britannicaoverseas.com"

# Inbound mail (IMAP) — defaults to SMTP_* if unset, but use these to override.
# IMAP_HOST="mail.britannicaoverseas.com"
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER="info@britannicaoverseas.com"
# IMAP_PASS="your-email-password"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# API
API_KEY="your-api-key-for-external-leads"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Public URL of THIS backend — used to build the open-tracking pixel URL that
# gets embedded in every outgoing mail (campaign + quick send). MUST be an
# HTTPS URL that recipient mail clients can reach, e.g. https://api.tutelagestudy.com
# If empty, the pixel is skipped and Opened counts stay at 0 — you'll see a
# warning at server startup. Not needed in local dev (recipient clients can't
# reach localhost anyway).
# Also used for: campaign open-tracking pixels, the customer-facing quote link
# ("View & accept online" in quote emails, /api/public/quotes/<token>?t=<slug>)
# and the button that link sits behind. Leave empty and those are silently
# skipped — mail still goes out.
APP_URL=""

# API usage tracking — persistent-counter window, in IST (24h clock).
# Requests outside this window are shown live but NOT written to the DB, so no
# rows accumulate off-hours. Defaults: 9am–8pm. Set both to 0 to track 24/7.
METRICS_TRACK_START_HOUR="9"
METRICS_TRACK_END_HOUR="20"

# Firebase Cloud Messaging (Android counsellor app)
# Path to service-account JSON downloaded from Firebase console
FCM_SERVICE_ACCOUNT_PATH="./secrets/fcm-service-account.json"

# Mobile JWT (separate audience from web JWT so sessions can be revoked independently)
JWT_MOBILE_SECRET="change-me-mobile-secret"
JWT_MOBILE_EXPIRES_IN="30d"

# Recording retention in days (auto-purge cron)
RECORDING_RETENTION_DAYS=90
