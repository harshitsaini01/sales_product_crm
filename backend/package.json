{
  "name": "crm-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "db:seed:lifecycle": "tsx prisma/seed-lifecycle.ts",
    "platform:generate": "node scripts/prisma-schema-cli.js --schema=platform --platform generate",
    "platform:ensure-schema": "tsx scripts/ensure-platform-schema.ts",
    "platform:migrate": "npm run platform:ensure-schema && node scripts/prisma-schema-cli.js --schema=platform --platform migrate deploy",
    "platform:migrate:dev": "node scripts/prisma-schema-cli.js --schema=platform --platform migrate dev",
    "platform:studio": "node scripts/prisma-schema-cli.js --schema=platform --platform studio",
    "platform:bootstrap": "tsx scripts/bootstrap-platform.ts",
    "tenant:migrate:all": "tsx scripts/migrate-all-tenants.ts",
    "tenant:directory:rebuild": "tsx scripts/rebuild-directory.ts",
    "tenant:verify": "tsx scripts/verify-tenancy.ts",
    "verticals:verify": "tsx scripts/verify-verticals.ts",
    "tenant:vertical": "tsx scripts/set-vertical.ts",
    "tenant:feature": "tsx scripts/set-feature.ts",
    "seed:teams": "tsx scripts/seed-teams.ts",
    "seed:products": "tsx scripts/seed-products.ts",
    "seed:b2b": "tsx scripts/seed-b2b-demo.ts",
    "smoke:b2b": "tsx scripts/smoke-b2b-flow.ts",
    "check:me": "tsx scripts/check-me.ts",
    "backfill:activity": "tsx scripts/backfill-lead-activity.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "metrics:check": "tsx scripts/check-api-metrics.ts",
    "phones:normalize": "tsx scripts/normalize-phones.ts",
    "phones:normalize:apply": "tsx scripts/normalize-phones.ts --apply",
    "tenant:drift": "tsx scripts/check-drift.ts",
    "tenant:baseline": "tsx scripts/baseline-migration.ts",
    "fingerprint": "tsx scripts/fingerprint-schemas.ts",
    "verify:guard": "tsx scripts/verify-migration-guard.ts",
    "db:migrate:unguarded": "prisma migrate deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "@prisma/client": "^5.22.0",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "firebase-admin": "^13.8.0",
    "hono": "^4.6.14",
    "imapflow": "^1.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.20.0",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
