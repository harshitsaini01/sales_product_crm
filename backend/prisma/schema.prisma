model SentMail {
  id           BigInt    @id @default(autoincrement())
  leadId       BigInt?   @map("lead_id")
  userId       BigInt    @map("user_id")
  toEmail      String    @map("to_email") @db.VarChar(200)
  subject      String    @db.VarChar(200)
  body         String
  status       String?   @db.VarChar(20) // 'sent' | 'failed' | 'pending'
  // Tracking columns — mirror what EmailCampaignRecipient carries so the
  // Sent History and Reports tabs show the same funnel for quick sends as
  // for scheduled campaigns.
  //   messageId    — RFC Message-ID captured from SMTP for reply threading
  //   groupId      — which email account sent it (null = default .env SMTP)
  //   openedAt     — set by the /api/tracking/quick-open/:id pixel on first fetch
  //   errorMessage — SMTP error string when a send fails
  messageId    String?   @map("message_id") @db.VarChar(255)
  groupId      BigInt?   @map("group_id")
  openedAt     DateTime? @map("opened_at")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([messageId])
  @@index([toEmail, createdAt])
  @@map("sent_mails")
}

model StudentMailHistory {
