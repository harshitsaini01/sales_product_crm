  subject   String   @db.VarChar(200)
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id])

  @@map("student_mail_histories")
}

model UniversityApplicationMail {
  id             BigInt    @id @default(autoincrement())
  studentId      BigInt    @map("student_id")
  toEmail        String    @map("to_email") @db.VarChar(200)
  cc             String?   @db.VarChar(200)
  greeting       String?   @db.VarChar(100)
  recipientName  String?   @map("recipient_name") @db.VarChar(200)
  senderName     String?   @map("sender_name") @db.VarChar(200)
  program        String?   @db.VarChar(200)
  universityName String?   @map("university_name") @db.VarChar(200)
  subject        String    @db.VarChar(250)
  body           String    @db.Text
  attachedDocs   String?   @map("attached_docs") @db.Text
  sentByUserId   BigInt?   @map("sent_by_user_id")
  trackingToken  String    @unique @map("tracking_token") @db.VarChar(64)
  isOpened       Boolean   @default(false) @map("is_opened")
  openCount      Int       @default(0) @map("open_count")
  firstOpenedAt  DateTime? @map("first_opened_at")
  lastOpenedAt   DateTime? @map("last_opened_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  student Lead  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sentBy  User? @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@map("university_application_mails")
}

// ─── EMAIL CAMPAIGNS ─────────────────────────────────────────────────────────
// CampaignGroup = one configured sender (webmail account: SMTP for outbound,
// IMAP for inbound). authorityScore (1-10) controls how much of a campaign's
// recipient list this group is given when distribution = AUTHORITY.
// hourlyCap = max sends per hour for this group (default 50). Counters are
// stored on EmailCampaignChunk so the scheduler can tell when a group is "full"
// for the current hour.

model CampaignGroup {
  id              BigInt   @id @default(autoincrement())
  name            String   @db.VarChar(120)
  fromName        String   @map("from_name") @db.VarChar(120)
  fromEmail       String   @unique @map("from_email") @db.VarChar(160)
  // Outbound (SMTP)
  smtpHost        String   @map("smtp_host") @db.VarChar(160)
  smtpPort        Int      @map("smtp_port")
  smtpUser        String   @map("smtp_user") @db.VarChar(160)
  smtpPass        String   @map("smtp_pass") @db.VarChar(255)
  smtpSecure      Boolean  @default(true) @map("smtp_secure")
  // Inbound (IMAP) — used by the inbox poller for replies
  imapHost        String?  @map("imap_host") @db.VarChar(160)
  imapPort        Int?     @map("imap_port")
  imapUser        String?  @map("imap_user") @db.VarChar(160)
  imapPass        String?  @map("imap_pass") @db.VarChar(255)
  imapSecure      Boolean  @default(true) @map("imap_secure")
  imapLastUid     Int?     @map("imap_last_uid") // resume polling after reboot
  // Throughput + ranking
  hourlyCap       Int      @default(50) @map("hourly_cap")
  authorityScore  Int      @default(5) @map("authority_score") @db.SmallInt // 1..10
  isActive        Boolean  @default(true) @map("is_active")
  // Telemetry (rolling — periodically reset by the scheduler)
  bouncesThisHour Int      @default(0) @map("bounces_this_hour")
  sentThisHour    Int      @default(0) @map("sent_this_hour")
  hourWindowAt    DateTime @default(now()) @map("hour_window_at")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  chunks     EmailCampaignChunk[]
  recipients EmailCampaignRecipient[]
  inbound    InboundMail[]

  @@map("campaign_groups")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignDistribution {
  AUTHORITY // weighted by group.authorityScore
  EQUAL // round-robin
  MANUAL // explicit per-group counts
}

enum RecipientStatus {
  QUEUED
  SENT
  DELIVERED // SMTP accepted (best we can know without DSN)
  BOUNCED
  FAILED
  UNSUBSCRIBED
  REPLIED
}

model EmailCampaign {
  id              BigInt               @id @default(autoincrement())
  userId          BigInt               @map("user_id") // creator
  name            String               @db.VarChar(160)
  subject         String               @db.VarChar(240)
  bodyHtml        String               @map("body_html") // pre-merge template, may contain {{name}}
  signatureId     BigInt?              @map("signature_id")
  status          CampaignStatus       @default(DRAFT)
  distribution    CampaignDistribution @default(AUTHORITY)
  totalRecipients Int                  @default(0) @map("total_recipients")
  chunkSize       Int                  @default(50) @map("chunk_size")
  batchGapMs      Int                  @default(3600000) @map("batch_gap_ms") // 1h
  perEmailDelayMs Int                  @default(5000) @map("per_email_delay_ms")
  startAt         DateTime             @map("start_at") // first chunk fires at/after this
  finishedAt      DateTime?            @map("finished_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  chunks     EmailCampaignChunk[]
  recipients EmailCampaignRecipient[]

  @@index([status, startAt])
  @@map("email_campaigns")
}

model EmailCampaignChunk {
  id          BigInt    @id @default(autoincrement())
  campaignId  BigInt    @map("campaign_id")
  groupId     BigInt    @map("group_id")
  index       Int // 0-based position within campaign per group
  scheduledAt DateTime  @map("scheduled_at")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  attempted   Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)

  campaign   EmailCampaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group      CampaignGroup            @relation(fields: [groupId], references: [id])
  recipients EmailCampaignRecipient[]

  @@index([campaignId])
  @@index([scheduledAt])
  @@map("email_campaign_chunks")
}

model EmailCampaignRecipient {
  id           BigInt          @id @default(autoincrement())
  campaignId   BigInt          @map("campaign_id")
  chunkId      BigInt?         @map("chunk_id")
  groupId      BigInt?         @map("group_id")
  leadId       BigInt?         @map("lead_id")
  toEmail      String          @map("to_email") @db.VarChar(200)
  toName       String?         @map("to_name") @db.VarChar(160)
  status       RecipientStatus @default(QUEUED)
  messageId    String?         @map("message_id") @db.VarChar(255) // RFC Message-ID for reply threading
  sentAt       DateTime?       @map("sent_at")
  errorMessage String?         @map("error_message")
  openedAt     DateTime?       @map("opened_at")
  repliedAt    DateTime?       @map("replied_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  campaign EmailCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  chunk    EmailCampaignChunk? @relation(fields: [chunkId], references: [id])
  group    CampaignGroup?      @relation(fields: [groupId], references: [id])
  lead     Lead?               @relation(fields: [leadId], references: [id])
  inbound  InboundMail[]

  @@unique([campaignId, toEmail], name: "campaign_recipient_uk")
  @@index([status])
  @@index([messageId])
  @@map("email_campaign_recipients")
}

// Inbound mail captured by the IMAP poller. Linked to a recipient row via
// In-Reply-To / References header matching against EmailCampaignRecipient.messageId,
// and to a lead by email address. Drives the "any revert on that mail" feature
// + the lead-detail inbox tab.

model InboundMail {
  id          BigInt   @id @default(autoincrement())
  groupId     BigInt   @map("group_id")
  imapUid     Int      @map("imap_uid")
  messageId   String?  @map("message_id") @db.VarChar(255)
  inReplyTo   String?  @map("in_reply_to") @db.VarChar(255)
  fromEmail   String   @map("from_email") @db.VarChar(200)
  fromName    String?  @map("from_name") @db.VarChar(160)
  toEmail     String   @map("to_email") @db.VarChar(200)
  subject     String   @db.VarChar(500)
  bodyHtml    String?  @map("body_html")
  bodyText    String?  @map("body_text")
  receivedAt  DateTime @map("received_at")
  leadId      BigInt?  @map("lead_id")
  recipientId BigInt?  @map("recipient_id") // EmailCampaignRecipient.id when this is a reply to a campaign mail
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  group     CampaignGroup           @relation(fields: [groupId], references: [id])
  lead      Lead?                   @relation(fields: [leadId], references: [id])
  recipient EmailCampaignRecipient? @relation(fields: [recipientId], references: [id])

  @@unique([groupId, imapUid], name: "inbound_group_uid_uk")
  @@index([leadId])
  @@index([receivedAt])
  @@map("inbound_mails")
}

// ─── CHAT ────────────────────────────────────────────────────────────────────

model ChatMessage {
  id        BigInt   @id @default(autoincrement())
  fromId    BigInt   @map("from_id")
  toId      BigInt   @map("to_id")
  message   String
  seen      Int      @default(0) @db.SmallInt
  locked    Int      @default(0) @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  from User @relation("ChatSender", fields: [fromId], references: [id])
  to   User @relation("ChatRecipient", fields: [toId], references: [id])

  // Bell feed: unseen-message count for the current user.
  @@index([toId, seen])
  @@map("chat_messages")
}

// ─── FINANCIAL ───────────────────────────────────────────────────────────────

model Invoice {
  id          BigInt    @id @default(autoincrement())
  leadId      BigInt    @map("lead_id")
  userId      BigInt    @map("user_id")
  invoiceNo   String    @map("invoice_no") @db.VarChar(50)
  amount      Decimal   @db.Decimal(10, 2)
  dueDate     DateTime? @map("due_date") @db.Date
  status      String    @default("pending") @db.VarChar(20)
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  payments FeePayment[]
  user     User         @relation(fields: [userId], references: [id])

  @@map("tbl_invoicelist")
}

model FeePayment {
  id        BigInt   @id @default(autoincrement())
  invoiceId BigInt   @map("invoice_id")
  leadId    BigInt   @map("lead_id")
  amount    Decimal  @db.Decimal(10, 2)
  paidAt    DateTime @map("paid_at") @db.Date
  mode      String?  @db.VarChar(50)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("tbl_feespayment")
}

// ─── TASKS & TODOS ───────────────────────────────────────────────────────────

model Task {
  id           BigInt    @id @default(autoincrement())
  title        String    @db.VarChar(200)
  description  String?
  /// What this task is about: lead | account | contact | deal | quote | order.
  ///
  /// Both NULL for every task that existed before the B2B work, which is
  /// accurate — a task had no subject at all until now, so nothing is lost and
  /// no existing query changes meaning.
  entityType   String?   @map("entity_type") @db.VarChar(20)
  entityId     BigInt?   @map("entity_id")
  assignedById BigInt    @map("assigned_by_id")
  assignedToId BigInt    @map("assigned_to_id")
  dueDate      DateTime? @map("due_date") @db.Date
  status       Int       @default(0) @db.SmallInt
  priority     String    @default("medium") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  assignedBy User @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedTo User @relation("AssignedTo", fields: [assignedToId], references: [id])

  // Bell feed: open tasks ordered by due date.
  @@index([status, dueDate])
  @@index([entityType, entityId])
  @@index([assignedToId, status])
  @@map("tbl_todolist")
}

// A dated calling assignment. Unlike generic Tasks, this permanently records
// the exact leads the counsellor must work and lets progress be calculated
// from the live lead activity.
model LeadWorkBatch {
  id           BigInt    @id @default(autoincrement())
  title        String    @db.VarChar(200)
  // Null when the task was hand-picked from the leads list (arbitrary
  // created-dates); set when it came from a single created-date cohort.
  leadDate     DateTime? @map("lead_date") @db.Date
  dueDate      DateTime? @map("due_date") @db.Date
  workDate     DateTime  @default(now()) @map("work_date") @db.Date
  workType     String    @default("INITIAL_CALL") @map("work_type") @db.VarChar(30)
  sequence     Int       @default(1)
  priority     String    @default("high") @db.VarChar(20)
  notes        String?   @db.Text
  status       Int       @default(0) @db.SmallInt // 0=open, 1=completed, 2=cancelled
  assignedById BigInt    @map("assigned_by_id")
  assignedToId BigInt    @map("assigned_to_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  assignedBy User                @relation("LeadWorkBatchCreator", fields: [assignedById], references: [id])
  assignedTo User                @relation("LeadWorkBatchAssignee", fields: [assignedToId], references: [id])
  items      LeadWorkBatchItem[]

  @@index([assignedToId, workDate, sequence])
  @@index([assignedToId, status, dueDate])
  // /workload asks for one work date across every counsellor, so neither of the
  // assignee-leading indexes above can serve it.
  @@index([workDate, status])
  @@map("lead_work_batches")
}

model LeadWorkBatchItem {
  id             BigInt    @id @default(autoincrement())
  batchId        BigInt    @map("batch_id")
  leadId         BigInt    @map("lead_id")
  completedAt    DateTime? @map("completed_at")
  completionType String?   @map("completion_type") @db.VarChar(30)
  createdAt      DateTime  @default(now()) @map("created_at")

  batch LeadWorkBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lead  Lead          @relation(fields: [leadId], references: [id])

  @@unique([batchId, leadId])
  @@index([leadId])
  @@map("lead_work_batch_items")
}

// ─── REMINDERS ───────────────────────────────────────────────────────────────

model Reminder {
  id           BigInt   @id @default(autoincrement())
  leadId       BigInt   @map("lead_id")
  userId       BigInt   @map("user_id")
  reminderDate DateTime @map("reminder_date") @db.Timestamptz(6)
  note         String?
  status       Int      @default(0) @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([leadId, reminderDate])
  // Bell feed: today's open reminders, all users (admin) or one (counsellor).
  @@index([reminderDate, status])
  @@index([userId, reminderDate])
  @@map("tbl_reminder")
}

// ─── EVENTS / CALENDAR ───────────────────────────────────────────────────────

model Event {
  id          BigInt    @id @default(autoincrement())
  title       String    @db.VarChar(200)
