// ─── UI FLAGS ────────────────────────────────────────────────────────────────

model FlagMessage {
  id        BigInt   @id @default(autoincrement())
  leadId    BigInt   @map("lead_id")
  userId    BigInt   @map("user_id")
  message   String
  type      String   @db.VarChar(50) // "send" or "rcv"
  createdAt DateTime @default(now()) @map("created_at")

  // Bell feed: newest 10 flags of one type.
  @@index([type, createdAt])
  // Every lead-detail open reads this table by leadId, and without an index
  // that is a sequential scan of every flag ever raised — invisible at six
  // counsellors, fatal once the table is shared by many. Matches the
  // [leadId, createdAt] shape the other lead sub-resources already use.
  @@index([leadId, createdAt])
  @@map("flag_messages")
}

// ─── STUDENT EDUCATION HISTORY & EXAMS ────────────────────────────────────────
// Replicates legacy Common.addSchool/updSchool/updUcat/updDmat/updSat/addFB/updFB.
