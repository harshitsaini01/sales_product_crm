// ─── MOBILE APP: CALLS + DEVICES ─────────────────────────────────────────────
// MobileCall stores calls synced from the Android counsellor app (GSM calls
// captured by CallMonitorService). Distinct from manual CallLog used by the
// web CRM. Both can coexist; admin dashboards roll up from MobileCall.

enum MobileCallDirection {
  OUTGOING
  INCOMING
}

enum MobileCallStatus {
  TRIGGERED // CRM created the trigger; phone hasn't reported yet
  RINGING
  ANSWERED
  MISSED
  REJECTED
  NO_ANSWER
  BUSY
  FAILED
}

model MobileCall {
  id                 BigInt              @id @default(autoincrement())
  deviceCallId       String              @unique // sha1(phone+startEpoch+userId), idempotency key
  userId             BigInt              @map("user_id") // counsellor
  leadId             BigInt?             @map("lead_id")
  phoneNumber        String              @map("phone_number") @db.VarChar(32)
  direction          MobileCallDirection
  status             MobileCallStatus
  startedAt          DateTime            @map("started_at")
  endedAt            DateTime?           @map("ended_at")
  durationSec        Int                 @default(0) @map("duration_sec")
  recordingPath      String?             @map("recording_path")
  recordingSize      Int?                @map("recording_size")
  recordingExpiresAt DateTime?           @map("recording_expires_at") // 90-day retention
  recordingPreserved Boolean             @default(false) @map("recording_preserved") // admin flag, skip purge
  triggeredFrom      String?             @map("triggered_from") @db.VarChar(20) // CRM_WEB | APP_DIALER | INCOMING | AUTO_DIALER
  triggerCallId      BigInt?             @map("trigger_call_id") // self-ref to TRIGGERED row when web initiated
  campaignContactId  BigInt?             @map("campaign_contact_id") // auto-dialer: links to AutoDialerCampaignContact
  recordingPlayedId  BigInt?             @map("recording_played_id") // auto-dialer: which AutoDialerRecording was played to callee
  // SIM / own-number that placed/received the call. Populated by the Android client
  // from CallLog.PHONE_ACCOUNT_ID + SubscriptionManager. simNumber is often null
  // because carriers hide the MSISDN; simSlot + simCarrier are the reliable fields.
  simSlot            Int?                @map("sim_slot") @db.SmallInt
  simCarrier         String?             @map("sim_carrier") @db.VarChar(80)
  simNumber          String?             @map("sim_number") @db.VarChar(32)
  notes              String?
  syncedAt           DateTime            @default(now()) @map("synced_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  user    User               @relation(fields: [userId], references: [id])
  lead    Lead?              @relation(fields: [leadId], references: [id])
  remarks CounsellorRemark[]

  @@index([userId, startedAt])
  @@index([leadId, startedAt])
  @@index([status, startedAt])
  @@index([recordingExpiresAt]) // for purge cron
  @@index([campaignContactId])
  @@map("mobile_calls")
}

model DeviceToken {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  fcmToken   String   @unique @map("fcm_token")
  deviceId   String   @map("device_id") @db.VarChar(100) // android device id
