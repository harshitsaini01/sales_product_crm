  leadId      BigInt   @map("lead_id")
  level       String?  @db.VarChar(50) // "10th" | "12th" | "graduation" | "post-graduation"
  schoolName  String?  @map("school_name") @db.VarChar(200)
  board       String?  @db.VarChar(100)
  passingYear Int?     @map("passing_year")
  percentage  String?  @db.VarChar(20)
  stream      String?  @db.VarChar(100)
  city        String?  @db.VarChar(100)
  country     String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
