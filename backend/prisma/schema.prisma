generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  sub_admin  @map("sub-admin")
  counsellor
  franchise
  employee
  agent
}

enum LeadType {
  new
  greetings
  neet_appearing  @map("neet-appearing")
  neet_qualified  @map("neet-qualified")
  qualified_leads @map("qualified-leads")
  not_interested  @map("not-interested")
  admission_drop  @map("admission-drop")
  future_leads    @map("future-leads")
  old_data        @map("old-data")
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id                      BigInt    @id @default(autoincrement())
  name                    String    @db.VarChar(100)
  role                    String    @default("employee") @db.VarChar(100)
  email                   String    @db.VarChar(100)
  mobile                  String    @db.VarChar(100)
  loginid                 String    @db.VarChar(100)
  username                String    @db.VarChar(100)
  password                String    @db.VarChar(250)
  passwordCopy            String?   @map("password_copy") @db.VarChar(250) // Plain text copy (legacy)
  nickName                String?   @map("nick_name") @db.VarChar(100)
  automaticAsignLead      Int       @default(0) @map("automatic_asign_lead") @db.SmallInt // Auto-assign new leads
  showFullPhone           Int       @default(0) @map("show_full_phone") @db.SmallInt // 1 = full phone numbers visible, 0 = masked
  showBucket              Boolean   @default(true) @map("show_bucket") // shared lead bucket visible to this user
  locationTrackingEnabled Boolean   @default(false) @map("location_tracking_enabled")
  locationRequired        Boolean   @default(false) @map("location_required")
  createdBy               BigInt?   @map("created_by") // Who created this user
  status                  Int       @default(1) @db.SmallInt
  branchId                BigInt?   @map("branch_id")
  designation             String?   @db.VarChar(100)
  gender                  String?   @db.VarChar(20)
  dob                     DateTime? @db.Date
  joiningDate             DateTime? @map("joining_date") @db.Date
  salary                  BigInt?
  address                 String?
  city                    String?   @db.VarChar(50)
  state                   String?   @db.VarChar(50)
  country                 String?   @db.VarChar(50)
  pincode                 String?   @db.VarChar(50)
  imgpath                 String?   @db.VarChar(255) // Profile photo URL
  newApplicant            Int       @default(0) @map("new_applicant") @db.SmallInt
  activeWebSessionId      String?   @map("active_web_session_id") @db.VarChar(64)
  activeMobileSessionId   String?   @map("active_mobile_session_id") @db.VarChar(64)
  lastActivityAt          DateTime? @map("last_activity_at")
  lastActivitySource      String?   @map("last_activity_source") @db.VarChar(20) // 'web' | 'mobile'
  // Phone-call suppression: when the mobile app reports a call in progress, we
  // stamp the start here. While non-null the inactivity scheduler skips raising
  // events for this user — calls protect against false half-days.
  onCallSince             DateTime? @map("on_call_since")
  onCallUpdatedAt         DateTime? @map("on_call_updated_at") // last time the call state flipped
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  branch                  Branch?                     @relation(fields: [branchId], references: [id])
  roles                   UserRole_[]
  assignedLeads           AsignedLead[]               @relation("CounsellorLeads")
  followups               LeadFollowup[]
  loginDetails            LoginDetail[]
  documents               UserDocument[]
  tasks                   Task[]                      @relation("AssignedBy")
  assignedTasks           Task[]                      @relation("AssignedTo")
  createdLeadWorkBatches  LeadWorkBatch[]             @relation("LeadWorkBatchCreator")
  assignedLeadWorkBatches LeadWorkBatch[]             @relation("LeadWorkBatchAssignee")
  sentMails               SentMail[]
  sentUniversityMails     UniversityApplicationMail[]
  reminders               Reminder[]
  announcements           Announcement[]              @relation("AnnouncementCreator")
  announcementReads       AnnouncementRead[]
  leaves                  EmployeeLeave[]
  chatMessages            ChatMessage[]               @relation("ChatSender")
  receivedMessages        ChatMessage[]               @relation("ChatRecipient")
  invoices                Invoice[]
  leadNotes               LeadNote[]
  leadComments            LeadComment[]
  // ── B2B core (crm_* tables). Relation fields only: no column is added to
  //    `users` by any of these — the foreign key lives on the new table.
  ownedAccounts           Account[]                   @relation("AccountOwner")
  createdAccounts         Account[]                   @relation("AccountCreator")
  ownedContacts           Contact[]                   @relation("ContactOwner")
  activities              Activity[]                  @relation("ActivityActor")
  crmNotes                CrmNote[]                   @relation("CrmNoteAuthor")
  ownedDeals              Deal[]                      @relation("DealOwner")
  createdDeals            Deal[]                      @relation("DealCreator")
  ownedQuotes             Quote[]                     @relation("QuoteOwner")
  ownedContracts          Contract[]                  @relation("ContractOwner")
  ownedOrders             Order[]                     @relation("OrderOwner")
  ownedCrmInvoices        CrmInvoice[]                @relation("CrmInvoiceOwner")
  recordedCrmPayments     CrmPayment[]                @relation("CrmPaymentRecorder")
  statusChanges           LeadStatusHistory[]
  callLogs                CallLog[]
  dailyReports            DailyReport[]
  mobileCalls             MobileCall[]
  deviceTokens            DeviceToken[]
  appReleases             AppRelease[]
  stagingBatches          LeadStagingBatchAssignee[]
  branchAccess            UserBranchAccess[]
  inactivityEvents        InactivityEvent[]
  bulkOperations          BulkOperation[]             @relation("BulkOperationActor")
  bulkPresets             BulkPreset[]                @relation("BulkPresetOwner")
  counsellorRemarks       CounsellorRemark[]          @relation("CounsellorRemarks")
  createdRemarks          CounsellorRemark[]          @relation("CreatedRemarks")
  catalogSends            LeadCatalogSend[]
  locationPoints          UserLocation[]
  deviceLocationStatus    UserDeviceLocationStatus?
  whatsappTemplates       WhatsappTemplate[]
  // ── Projects & proposals (crm_* tables, gated by the `projects` module).
  teamMemberships         CrmTeamMember[]             @relation("TeamMemberUser")
  ownedProjects           CrmProject[]                @relation("ProjectOwner")
  assignedProjects        CrmProject[]                @relation("ProjectAssignee")
  createdProjects         CrmProject[]                @relation("ProjectCreator")
  projectMessages         CrmProjectMessage[]         @relation("ProjectMessageAuthor")
  projectFiles            CrmProjectFile[]            @relation("ProjectFileUploader")
  stockMovements          StockMovement[]             @relation("StockMovementActor")
  createdShipments        Shipment[]                  @relation("ShipmentCreator")
  approvalDecisions       SalesApproval[]             @relation("ApprovalDecider")

  @@map("users")
}

// Immutable, server-timestamped samples sent by the authenticated counsellor app.
model UserLocation {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  latitude   Float
  longitude  Float
  accuracyM  Float?   @map("accuracy_m")
  altitudeM  Float?   @map("altitude_m")
  speedMps   Float?   @map("speed_mps")
  bearingDeg Float?   @map("bearing_deg")
  recordedAt DateTime @default(now()) @map("recorded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("user_locations")
}

// Last-known state of the four gate conditions the mobile app enforces
// (LocationGate.isBlocked in the counsellor app) — reported by the device
// itself on every check, not inferred from silence. This is what makes "GPS is
// on but the app was never granted location permission" (or any other single
// failing condition) visible on the admin dashboard instead of just showing up
// as a generic stale/no-data counsellor.
model UserDeviceLocationStatus {
  userId               BigInt   @id @map("user_id")
  permissionGranted    Boolean  @map("permission_granted")
  backgroundGranted    Boolean  @map("background_granted")
  gpsEnabled           Boolean  @map("gps_enabled")
  batteryExempt        Boolean  @map("battery_exempt")
  callPhoneGranted     Boolean  @default(true) @map("call_phone_granted")
  phoneStateGranted    Boolean  @default(true) @map("phone_state_granted")
  callLogGranted       Boolean  @default(true) @map("call_log_granted")
  recordAudioGranted   Boolean  @default(true) @map("record_audio_granted")
  notificationsGranted Boolean  @default(true) @map("notifications_granted")
  blocked              Boolean
  blockReason          String?  @map("block_reason") @db.VarChar(120)
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_device_location_status")
}

// Tracks counsellor inactivity windows. The scheduler raises a row whenever a
// counsellor crosses a threshold (warning → alert → halfday) without any
// activity; the popup is dismissed via /api/activity/ack which stamps ackAt.
// `source` records where the inactivity was observed — always 'server' since
// it's the cron that raises events; client just acks. Web + mobile activity
// is unified on User.lastActivityAt so there is no double-counting.
model InactivityEvent {
  id              BigInt    @id @default(autoincrement())
  userId          BigInt    @map("user_id")
  kind            String    @db.VarChar(20) // 'warning' | 'alert' | 'halfday'
  raisedAt        DateTime  @default(now()) @map("raised_at")
  ackAt           DateTime? @map("ack_at")
  // Free-text payload — minutes of inactivity at raise time, useful for audit.
  inactiveSeconds Int       @map("inactive_seconds")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, raisedAt])
  @@index([kind, raisedAt])
  @@map("inactivity_events")
}

// Counsellor daily report — what was done today, follow-up plans, leads contacted, etc.
// Replicates legacy Counsellor.addDailyReport / updateDailyReport.
model DailyReport {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  reportDate     DateTime @map("report_date") @db.Date
  leadsContacted Int      @default(0) @map("leads_contacted") @db.SmallInt
  callsMade      Int      @default(0) @map("calls_made") @db.SmallInt
  meetingsHeld   Int      @default(0) @map("meetings_held") @db.SmallInt
  enrollments    Int      @default(0) @db.SmallInt
  summary        String // What was accomplished
  challenges     String? // Blockers / issues
  tomorrowPlan   String?  @map("tomorrow_plan")
  status         Int      @default(1) @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, reportDate], name: "daily_report_user_date_uk")
  @@map("daily_reports")
}

model UserRole_ {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  role      String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_roles")
}

model LoginDetail {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  ip        String?  @db.VarChar(50)
  browser   String?  @db.VarChar(100)
  os        String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("login_details")
}

// ─── LEADS ───────────────────────────────────────────────────────────────────

model Lead {
  id                      BigInt    @id @default(autoincrement())
  // ── Personal Info ──────────────────────────────────────────
  name                    String    @db.VarChar(100)
  father                  String?   @db.VarChar(100) // Father's name
  mother                  String?   @db.VarChar(100) // Mother's name
  fatherMobile            String?   @map("father_mobile") @db.VarChar(20)
  motherMobile            String?   @map("mother_mobile") @db.VarChar(20)
  dob                     String?   @db.VarChar(100) // Date of birth
  gender                  String?   @db.VarChar(10)
  castCategory            String?   @map("cast_category") @db.VarChar(100) // Caste category
  nationality             String?   @db.VarChar(50)
  religion                String?   @db.VarChar(100)
  passportNumber          String?   @map("passport_number") @db.VarChar(100)
  firstLanguage           String?   @map("first_language") @db.VarChar(100)
  maritalStatus           String?   @map("marital_status") @db.VarChar(50)
  passportExpiry          String?   @map("passport_expiry") @db.VarChar(100)
  imgpath                 String? // Profile photo URL
  imgname                 String?   @db.VarChar(200) // Profile photo filename
  // ── Contact Info ──────────────────────────────────────────
  email                   String?   @db.VarChar(100) // Primary email
  email2                  String?   @db.VarChar(100) // Secondary email
  email3                  String?   @db.VarChar(100) // Tertiary email
  mobile                  String?   @db.VarChar(50) // Primary mobile
  mobile2                 String?   @db.VarChar(20) // Secondary mobile
  mobile3                 String?   @db.VarChar(20) // Tertiary mobile
  password                String?   @db.VarChar(100)
  // ── Address ──────────────────────────────────────────────
  city                    String?   @db.VarChar(100)
  state                   String?   @db.VarChar(50)
  country                 String?   @db.VarChar(100)
  pincode                 String?   @db.VarChar(20)
  homeAddress             String?   @map("home_address") @db.Text
  homeContactNumber       String?   @map("home_contact_number") @db.VarChar(50)
  // ── Academic ──────────────────────────────────────────────
  intrestedCourse         String?   @map("intrested_course") @db.VarChar(100)
  intrestedSubject        String?   @map("intrested_subject") @db.VarChar(100) // Interested subject
  intrestedUniversity     String?   @map("intrested_university") @db.VarChar(50)
  approximateBudget       String?   @map("approximate_budget") @db.VarChar(100) // Budget range
  highestQualification    String?   @map("highest_qualification") @db.VarChar(100)
  preferredDestination    String?   @map("preferred_destination") @db.VarChar(100)
  persuingCountry         String?   @map("persuing_country") @db.VarChar(100)
  englishExamType         String?   @map("english_exam_type") @db.VarChar(50)
  overallScore            Int?      @map("overall_score")
  neetscore               String?   @db.VarChar(20)
  neetRank                String?   @map("neet_rank") @db.VarChar(100)
  neetQualified           String?   @map("neet_qualified") @db.VarChar(100)
  neetPassingYear         Int?      @map("neet_passing_year")
  // ── Legacy Education & English Scores ─────────────────────
  countryOfEducation      String?   @map("country_of_education") @db.VarChar(100)
  highestLevelOfEducation String?   @map("highest_level_of_education") @db.VarChar(100)
  gradingScheme           String?   @map("grading_scheme") @db.VarChar(100)
  gradeAverage            String?   @map("grade_average") @db.VarChar(100)
  studentType             String?   @map("student_type") @db.VarChar(100)
  neetResult              String?   @map("neet_result") @db.VarChar(100)
  dateOfExam              String?   @map("date_of_exam") @db.VarChar(100)
  listeningScore          String?   @map("listening_score") @db.VarChar(50)
  readingScore            String?   @map("reading_score") @db.VarChar(50)
  writingScore            String?   @map("writing_score") @db.VarChar(50)
  speakingScore           String?   @map("speaking_score") @db.VarChar(50)
  // ── Legacy Education Qualifications ───────────────────────
  hs                      String?   @db.VarChar(50)
  hsSchoolName            String?   @map("hs_school_name") @db.VarChar(255)
  hsPassingYear           String?   @map("hs_passing_year") @db.VarChar(20)
  hsResult                String?   @map("hs_result") @db.VarChar(50)
  intr                    String?   @db.VarChar(50)
  intrSchoolName          String?   @map("intr_school_name") @db.VarChar(255)
  intrPassingYear         String?   @map("intr_passing_year") @db.VarChar(20)
  intrResult              String?   @map("intr_result") @db.VarChar(50)
  ug                      String?   @db.VarChar(50)
  ugSchoolName            String?   @map("ug_school_name") @db.VarChar(255)
  ugPassingYear           String?   @map("ug_passing_year") @db.VarChar(20)
  ugResult                String?   @map("ug_result") @db.VarChar(50)
  // ── Legacy Exams (UCAT, DMAT, SAT) ────────────────────────
  ucat                    Int?      @db.SmallInt
  ucatExamDate            String?   @map("ucat_exam_date") @db.VarChar(50)
  ucatVScore              String?   @map("ucat_v_score") @db.VarChar(50)
  ucatVRank               String?   @map("ucat_v_rank") @db.VarChar(50)
  ucatQScore              String?   @map("ucat_q_score") @db.VarChar(50)
  ucatQRank               String?   @map("ucat_q_rank") @db.VarChar(50)
  ucatWScore              String?   @map("ucat_w_score") @db.VarChar(50)
  ucatWRank               String?   @map("ucat_w_rank") @db.VarChar(50)
  dmat                    Int?      @db.SmallInt
  dmatExamDate            String?   @map("dmat_exam_date") @db.VarChar(50)
  dmatVScore              String?   @map("dmat_v_score") @db.VarChar(50)
  dmatVRank               String?   @map("dmat_v_rank") @db.VarChar(50)
  dmatQScore              String?   @map("dmat_q_score") @db.VarChar(50)
  dmatQRank               String?   @map("dmat_q_rank") @db.VarChar(50)
  dmatWScore              String?   @map("dmat_w_score") @db.VarChar(50)
  dmatWRank               String?   @map("dmat_w_rank") @db.VarChar(50)
  dmatIrScore             String?   @map("dmat_ir_score") @db.VarChar(50)
  dmatIrRank              String?   @map("dmat_ir_rank") @db.VarChar(50)
  dmatTotalScore          String?   @map("dmat_total_score") @db.VarChar(50)
  dmatTotalRank           String?   @map("dmat_total_rank") @db.VarChar(50)
  sat                     Int?      @db.SmallInt
  satExamDate             String?   @map("sat_exam_date") @db.VarChar(50)
  satReasoningPoints      String?   @map("sat_reasoning_points") @db.VarChar(50)
  satSubjectPoints        String?   @map("sat_subject_points") @db.VarChar(50)
  // ── Lead Tracking ─────────────────────────────────────────
  leadType                String    @default("new") @map("lead_type") @db.VarChar(50)
  leadStatus              String    @default("Fresh") @map("lead_status") @db.VarChar(100)
  leadSubStatus           String?   @map("lead_sub_status") @db.VarChar(100)
  leadStatusId            BigInt?   @map("lead_status_id")
  leadSubStatusId         BigInt?   @map("lead_sub_status_id")
  leadFollowStatus        BigInt?   @map("lead_follow_status")
  departmentId            BigInt?   @default(2) @map("department_id")
  statusLeadTypeId        BigInt?   @map("status_lead_type_id") // FK to lead_department_leadtypes
  userId                  BigInt    @default(28) @map("userid")
  event                   String?   @db.VarChar(50) // Source/event
  source                  String?   @db.VarChar(100)
  campaign                String?   @db.VarChar(255)
  keyword                 String?   @db.VarChar(255)
  sourceUrl               String?   @map("source_url")
  website                 String    @default("other") @db.VarChar(100)
  comment                 String?
  // ── Engagement Tracking ───────────────────────────────────
  called                  Int       @default(0) @db.SmallInt // Has been called (0/1)
  wapp                    Int       @default(0) @db.SmallInt // WhatsApp contacted (0/1)
  callAnsweredStatus      String?   @map("call_answered_status") @db.VarChar(50)
  flagSend                Int       @default(0) @map("flag_send") @db.SmallInt // Admin flagged
  flagRcv                 Int       @default(0) @map("flag_rcv") @db.SmallInt // Counsellor flagged
  // ── Date Tracking ────────────────────────────────────────
  followupDate            DateTime? @map("followup_date") @db.Date
  commentDate             DateTime? @map("comment_date") @db.Date // Last comment date
  reminderDate            DateTime? @map("reminder_date") @db.Date
  // ── Financial ────────────────────────────────────────────
  enrolled                Int?      @db.SmallInt
  course                  String?   @db.VarChar(100)
  totalFees               Int?      @map("total_fees")
  totalDepositFees        Int?      @map("total_deposit_fees")
  balanceFees             Int?      @map("balance_fees")
  // ── System ───────────────────────────────────────────────
  asign                   Int       @default(1) @db.SmallInt // Pending auto-assignment (1=pending, 0=done)
  trash                   Int       @default(0) @db.SmallInt // Soft deleted
  status                  Int?      @db.SmallInt
  // Duplicate tracking — when same email/mobile submits the website form again,
  // we insert a new row with isDuplicate=true + duplicateOfId pointing to the original.
  isDuplicate             Boolean   @default(false) @map("is_duplicate")
  duplicateOfId           BigInt?   @map("duplicate_of_id")
  // Set when an admin explicitly unassigns the lead. Such leads stay in their
  // own department and don't fall back into the shared `/bucket` pool. Cleared
  // when the lead is assigned to a counsellor again.
  bucketExcluded          Boolean   @default(false) @map("bucket_excluded")
  // Lead score — increments +1 each time a call to this lead is picked up.
  // Simple counter, no decay, no upper cap. Shown as a chip on the lead card.
  leadScore               Int       @default(0) @map("lead_score")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  assignedTo         AsignedLead[]
  workBatchItems     LeadWorkBatchItem[]
  followups          LeadFollowup[]
  notes              LeadNote[]
  /// B2B extension. Optional, and absent for an education customer.
  business           LeadBusiness?
  comments           LeadComment[]
  documents          StudentDocument[]
  reminders          Reminder[]
  mailHistories      StudentMailHistory[]
  statusHistory      LeadStatusHistory[]
  catalogSends       LeadCatalogSend[]
  callLogs           CallLog[]
  mobileCalls        MobileCall[]
  schoolHistory      StudentSchoolHistory[]
  examUcat           StudentExamUcat?
  examDmat           StudentExamDmat?
  examSat            StudentExamSat?
  feedbacks          StudentFeedback[]
  campaignRecipients EmailCampaignRecipient[]
  inboundMails       InboundMail[]
  universityMails    UniversityApplicationMail[]

  // The task builder's cohort query and every dated Leads listing run
  // `WHERE trash = 0 ORDER BY created_at DESC`. Without this the planner did a
  // parallel seq scan plus an external merge sort that spilled to disk.
  @@index([trash, createdAt])
  // The notification bell asks "which leads are due or overdue for follow-up"
  // every 60 s, once as a findMany-with-sort and once as a count. Unindexed,
  // that was two seq scans of the whole table per poll.
  @@index([trash, followupDate])
  @@map("leads")
}

// ─── LEAD ASSIGNMENT ─────────────────────────────────────────────────────────

model AsignedLead {
  id                   BigInt   @id @default(autoincrement())
  clrId                BigInt   @map("clr_id")
  stdId                BigInt   @map("std_id")
  leadType             String   @default("new") @map("lead_type") @db.VarChar(255)
  leadStatusId         BigInt?  @map("lead_status_id")
  leadSubStatusId      BigInt?  @map("lead_sub_status_id")
  leadFollowUpStatusId BigInt?  @map("lead_follow_up_status_id")
  callAnsweredStatus   Int?     @map("call_answered_status") @db.SmallInt
  departmentId         BigInt?  @default(2) @map("department_id")
  statusLeadTypeId     BigInt?  @map("status_lead_type_id")
  called               Int      @default(0) @db.SmallInt
  wapp                 Int      @default(0) @db.SmallInt
  status               Int      @default(1) @db.SmallInt
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  counsellor User @relation("CounsellorLeads", fields: [clrId], references: [id])
  lead       Lead @relation(fields: [stdId], references: [id])

  // "Who owns this lead" (cohort snapshot) and "what does this counsellor hold"
  // are the only two ways this table is ever read, and both filter on status = 1.
  @@index([stdId, status])
  @@index([clrId, status])
  @@map("asigned_leads")
}

// ─── LEAD STATUS SYSTEM ───────────────────────────────────────────────────────

model LeadStatus {
  id           BigInt   @id @default(autoincrement())
  title        String   @db.VarChar(100)
  slug         String   @db.VarChar(100)
  departmentId BigInt   @map("department_id")
  moveTo       String?  @map("move_to") @db.VarChar(100)
  priority     Int      @default(0)
  status       Int      @default(1) @db.SmallInt // 1 = active, 0 = disabled (hidden from UI)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subStatuses LeadSubStatus[]

  @@map("lead_statuses")
}

model LeadSubStatus {
